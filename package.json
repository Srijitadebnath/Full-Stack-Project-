    "vite": "^8.3.0"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "lucide-react": "^1.48.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
